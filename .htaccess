# @loom-file release=0.15.18 revision=5 policy=package-priority
DirectoryIndex index.php index.html
Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Permanent LOOM Home recovery route. The installation base may be owned by a project.
  RewriteRule ^home/?$ home/index.php [L]

  # Instance Project virtual filesystem. Keeping the project-relative path in the
  # browser URL means import.meta.url, relative ES module imports, CSS url(),
  # and new URL('./asset', import.meta.url) work exactly like normal files.
  RewriteRule ^api/project-file/([a-zA-Z0-9_-]+)/(.*)$ api/project-file.php?project=$1&path=$2 [B,QSA,L]

  # Public project gateways inject crawler-visible SEO/Open Graph metadata
  # before returning the existing LOOM shell. Instance Projects keep their real
  # project slug in the query string while sharing the _instance shell.
  RewriteRule ^projects/_instance/app/?$ project.php [QSA,L]
  RewriteRule ^projects/([a-zA-Z0-9_-]+)/app/?$ project.php?project=$1 [B,QSA,L]

  # Friendly extensionless URLs: /something -> /something.html or /something.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|js|mjs|css|json|png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
</IfModule>
