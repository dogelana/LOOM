  "user_actions": [],
  "admin_settings": {
    "title": "Project Branding",
    "description": "Browser title, optional tagline, and project favicon.",
    "fields": [
      {
        "id": "tagline",
        "label": "Tagline",
        "type": "text",
        "maxLength": 120
