      "tagline",
      "favicon",
      "reusable"
    ],
    "steps": [
      {
        "id": "read-project",
        "name": "Read project identity"
      },
      {
        "id": "set-title",
        "name": "Apply project title and tagline"
      },
      {
        "id": "resolve-favicon",
        "name": "Resolve favicon source"
      },
      {
        "id": "set-favicon",
        "name": "Apply favicon"
      }
    ]
