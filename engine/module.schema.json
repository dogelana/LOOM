{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/schema/module.schema.json",
  "title": "LOOM Action Module Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "action",
    "module"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5",
        "1.6",
        "1.7",
        "1.8"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "behavior"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "system",
            "user"
          ]
        },
        "behavior": {
          "enum": [
            "transient",
            "stateful",
            "pending"
          ]
        },
        "autostart": {
          "type": "boolean"
        },
        "parent": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "user_actions": {
      "type": "array",
      "description": "Semantic user actions owned by this module. LOOM renders these as Pegboard pills and records action.state events with kind=user.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "behavior": {
            "enum": [
              "transient",
              "pending",
              "stateful"
            ],
            "default": "transient"
          },
          "category": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Domain log event names that automatically trigger this user action."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "entry",
        "version"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "order_locked": {
          "type": "boolean"
        },
        "bootstrap": {
          "type": "object",
          "description": "Optional LOOM bootstrap behavior processed before normal project module activation.",
          "properties": {
            "role": {
              "enum": [
                "loader"
              ]
            },
            "priority": {
              "type": "integer"
            },
            "countSelf": {
              "type": "boolean"
            }
          }
        },
        "scope": {
          "enum": [
            "global",
            "project"
          ],
          "description": "Core-module ownership scope. Project-scoped core modules are LOOM-owned but configured independently per project."
        }
      }
    },
    "config": {
      "type": "object"
    },
    "pegboard": {
      "type": "object"
    },
    "presentation": {
      "type": "object",
      "description": "Standard LOOM module placement/presentation declaration. Modules own their styling; LOOM resolves regions/slots and applies normalized positioning hints.",
      "properties": {
        "role": {
          "enum": [
            "region",
            "content"
          ]
        },
        "region": {
          "type": "string"
        },
        "mount": {
          "type": "object",
          "properties": {
            "region": {
              "type": "string"
            },
            "slot": {
              "type": "string"
            }
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "width": {
              "enum": [
                "auto",
                "content",
                "full"
              ]
            },
            "align": {
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ]
            },
            "position": {
              "enum": [
                "flow",
                "relative",
                "absolute",
                "sticky",
                "fixed"
              ]
            },
            "order": {
              "type": "integer"
            },
            "layer": {
              "type": "integer"
            },
            "maxWidth": {
              "type": "string"
            },
            "minHeight": {
              "type": "string"
            },
            "margin": {
              "type": "string"
            },
            "padding": {
              "type": "string"
            },
            "className": {
              "type": "string"
            },
            "offsetX": {
              "type": "string"
            },
            "offsetY": {
              "type": "string"
            }
          }
        },
        "collapsible": {
          "type": "boolean",
          "description": "Whether LOOM should wrap root content with the persistent collapse/expand header."
        },
        "orb": {
          "type": "object",
          "description": "Optional Orb Dock presentation metadata.",
          "properties": {
            "defaultCaptured": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            },
            "defaultEmoji": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "admin_settings": {
      "type": "object",
      "description": "Declarative administrator controls for safe persistent overrides of module config.",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "configKey": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "text",
                  "number",
                  "range",
                  "color",
                  "select",
                  "checkbox"
                ]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "maxLength": {
                "type": "integer"
              },
              "options": {
                "type": "array"
              },
              "projectDefaultFromExtension": {
                "type": "object",
                "properties": {
                  "extension": {
                    "type": "string"
                  },
                  "property": {
                    "type": "string"
                  }
                },
                "required": [
                  "extension",
                  "property"
                ]
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9._-]+$"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "favicon",
                  "config-presets",
                  "orb-manager"
                ]
              },
              "customPath": {
                "type": "string"
              },
              "logoActionId": {
                "type": "string"
              },
              "presets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "reset": {
                      "type": "boolean"
                    },
                    "values": {
                      "type": "object"
                    },
                    "requiresExtension": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Declarative project/core extension capabilities. Runtime behavior is supplied by the module instance extensions object.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "creator": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Machine-readable module capability contract. Additive in 0.12.08.",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "optional": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "story": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
