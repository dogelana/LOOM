{
  "schema_version": "1.3",
  "enabled": true,
  "action": {
    "id": "core.ui.load-logo-text",
    "name": "Header Wordmark",
    "description": "Header-only project wordmark renderer. By default it inherits the canonical Project Identity wordmark, colors, and font; disabling this module hides header text only.",
    "kind": "system",
    "behavior": "stateful",
    "autostart": true,
    "parent": "core.ui.header-bar",
    "category": "core/ui/branding",
    "tags": [
      "core",
      "ui",
      "branding",
      "logo-text",
      "header-child",
      "stacked-wordmark"
    ],
    "steps": [
      {
        "id": "create-element",
        "name": "Create wordmark element"
      },
      {
        "id": "fit-text",
        "name": "Fit stacked text widths"
      },
      {
        "id": "mount-text",
        "name": "Inject wordmark into header"
      }
    ]
  },
  "module": {
    "entry": "action.js",
    "version": "2.5.0",
    "dependencies": [
      "core.ui.header-bar"
    ],
    "styles": [],
    "order": "00002",
    "scope": "project"
  },
  "presentation": {
    "role": "content",
    "mount": {
      "region": "header-bar",
      "slot": "brand-text"
    },
    "layout": {
      "width": "auto",
      "align": "start",
      "position": "flow",
      "order": 20,
      "maxWidth": "100%",
      "offsetY": "10px"
    }
  },
  "config": {
    "mountSelector": "#feature-stage",
    "line1": "PROJECT",
    "line2": "",
    "fontFamily": "League Spartan",
    "fontWeight": 900,
    "fontGoogleCss": "https://fonts.googleapis.com/css2?family=League+Spartan:wght@700;800;900&display=swap",
    "primaryColor": "#111111",
    "accentColor": "#168346",
    "opticalOffsetY": "10px",
    "fontSize": 54,
    "wordingSource": "project",
    "colorSource": "project",
    "fontSource": "project"
  },
  "pegboard": {
    "preferredDepth": 3,
    "accent": "green"
  },
  "user_actions": [],
  "admin_settings": {
    "title": "Header Wordmark / Logo Text",
    "description": "This module controls text in the HEADER only. Project Identity owns the canonical project wording/colors used by Loader, Home, and Footer. Disable this module to hide header text without changing those other locations, or choose Custom below for a header-only override.",
    "fields": [
      {
        "id": "wordingSource",
        "label": "Header wording source",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Project Identity wordmark"
          },
          {
            "value": "custom",
            "label": "Custom header wording"
          }
        ]
      },
      {
        "id": "line1",
        "label": "Custom header top line",
        "type": "text",
        "maxLength": 80,
        "visibleWhen": {
          "field": "wordingSource",
          "equals": "custom"
        }
      },
      {
        "id": "line2",
        "label": "Custom header bottom line",
        "type": "text",
        "maxLength": 80,
        "visibleWhen": {
          "field": "wordingSource",
          "equals": "custom"
        }
      },
      {
        "id": "colorSource",
        "label": "Header color source",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Project main + accent colors"
          },
          {
            "value": "custom",
            "label": "Custom header colors"
          }
        ]
      },
      {
        "id": "primaryColor",
        "label": "Custom header top-line color",
        "type": "color",
        "visibleWhen": {
          "field": "colorSource",
          "equals": "custom"
        }
      },
      {
        "id": "accentColor",
        "label": "Custom header bottom-line color",
        "type": "color",
        "visibleWhen": {
          "field": "colorSource",
          "equals": "custom"
        }
      },
      {
        "id": "fontSource",
        "label": "Header font source",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Project Identity font"
          },
          {
            "value": "custom",
            "label": "Custom header font"
          }
        ]
      },
      {
        "id": "fontFamily",
        "label": "Custom header font",
        "type": "select",
        "options": [
          {
            "value": "League Spartan",
            "label": "League Spartan"
          },
          {
            "value": "Arial Black",
            "label": "Arial Black"
          },
          {
            "value": "Impact",
            "label": "Impact"
          },
          {
            "value": "system-ui",
            "label": "System UI"
          },
          {
            "value": "Georgia",
            "label": "Georgia"
          }
        ],
        "visibleWhen": {
          "field": "fontSource",
          "equals": "custom"
        }
      },
      {
        "id": "fontSize",
        "label": "Header wordmark size",
        "type": "range",
        "min": 20,
        "max": 144,
        "step": 1,
        "unit": "px"
      }
    ]
  }
}
