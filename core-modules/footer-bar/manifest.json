{
  "schema_version": "1.8",
  "enabled": true,
  "action": {
    "id": "core.ui.footer-bar",
    "name": "Footer Bar",
    "description": "LOOM-owned three-zone project footer: project branding, conditional More Tools, and independently styled LOOM attribution with project-theme inheritance and fit-content controls.",
    "kind": "system",
    "behavior": "stateful",
    "autostart": true,
    "parent": "core.load",
    "category": "core/ui/layout",
    "tags": [
      "core",
      "ui",
      "layout",
      "region",
      "footer",
      "branding"
    ]
  },
  "module": {
    "entry": "action.js",
    "version": "2.1.0",
    "dependencies": [],
    "styles": [
      "action.css"
    ],
    "order": "00006",
    "scope": "project"
  },
  "presentation": {
    "role": "region",
    "region": "footer-bar",
    "mount": {
      "region": "footer-root"
    },
    "layout": {
      "width": "auto",
      "align": "stretch",
      "position": "flow",
      "order": 6,
      "className": "loom-project-footer-region"
    }
  },
  "config": {
    "cornerRadius": 30,
    "backgroundColor": "#F7FBF8",
    "widthMode": "full",
    "outerPadding": 18,
    "rowGap": 14,
    "projectLogoSize": 64,
    "projectTextSize": 17,
    "brandRowWidthMode": "fit-content",
    "brandRowAlign": "center",
    "brandRowPaddingX": 18,
    "brandRowPaddingY": 16,
    "brandRowRadius": 22,
    "brandRowBackground": "#FFFFFF",
    "toolsRowWidthMode": "fit-content",
    "toolsRowAlign": "center",
    "toolsRowPaddingX": 16,
    "toolsRowPaddingY": 13,
    "toolsRowRadius": 22,
    "toolsRowBackground": "#F4F9F5",
    "loomLogoSize": 50,
    "loomTextSize": 16,
    "loomRowWidthMode": "fit-content",
    "loomRowAlign": "center",
    "loomRowPaddingX": 18,
    "loomRowPaddingY": 15,
    "loomRowRadius": 22,
    "loomRowBackground": "#FFFFFF",
    "orbSlot": "orbs",
    "brandFitExtraWidth": 100,
    "brandFitExtraHeight": 20,
    "wordmarkMode": "project",
    "footerLine1": "",
    "footerLine2": "",
    "wordmarkColorMode": "project",
    "footerColor1": "#111111",
    "footerColor2": "#168346",
    "wordmarkFontMode": "project",
    "footerFontFamily": "League Spartan",
    "footerFontWeight": 900,
    "projectName": "Project",
    "projectWordmarkLine1": "PROJECT",
    "projectWordmarkLine2": "",
    "projectWordmarkPrimary": "#111111",
    "projectWordmarkAccent": "#168346",
    "projectWordmarkFontFamily": "League Spartan",
    "projectWordmarkFontWeight": 900,
    "projectWordmarkFontCss": "https://fonts.googleapis.com/css2?family=League+Spartan:wght@700;800;900&display=swap",
    "loomFitExtraWidth": 100,
    "loomFitExtraHeight": 20,
    "loomStrongColor": "#173C24",
    "loomTextColor": "#455A4B",
    "loomMetaColor": "#728078"
  },
  "pegboard": {
    "preferredDepth": 2,
    "accent": "green"
  },
  "user_actions": [],
  "admin_settings": {
    "title": "Footer Bar",
    "description": "Full-width footer shell with independently configurable project-brand, conditional More Tools, and Powered by LOOM rows. Project-facing surfaces inherit Project Identity colors; LOOM attribution keeps LOOM colors by default but every value remains overrideable.",
    "fields": [
      {
        "id": "outerPadding",
        "label": "Footer outer padding",
        "type": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "rowGap",
        "label": "Space between footer rows",
        "type": "range",
        "min": 0,
        "max": 48,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "cornerRadius",
        "label": "Footer outer corner radius",
        "type": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "backgroundColor",
        "label": "Footer outer background",
        "type": "color"
      },
      {
        "id": "widthMode",
        "label": "Whole footer width",
        "type": "select",
        "options": [
          {
            "value": "full",
            "label": "Full Width"
          },
          {
            "value": "fit-content",
            "label": "Fit Content"
          }
        ]
      },
      {
        "id": "wordmarkMode",
        "label": "Footer project text",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Project Identity wordmark"
          },
          {
            "value": "custom",
            "label": "Custom footer wording"
          },
          {
            "value": "hidden",
            "label": "Hidden \u00b7 logo only"
          }
        ],
        "help": "Independent from Header Wordmark. Hiding header text does not hide footer text, and vice versa."
      },
      {
        "id": "footerLine1",
        "label": "Custom footer top line",
        "type": "text",
        "maxLength": 80,
        "visibleWhen": {
          "field": "wordmarkMode",
          "equals": "custom"
        }
      },
      {
        "id": "footerLine2",
        "label": "Custom footer bottom line",
        "type": "text",
        "maxLength": 80,
        "visibleWhen": {
          "field": "wordmarkMode",
          "equals": "custom"
        }
      },
      {
        "id": "wordmarkColorMode",
        "label": "Footer wordmark colors",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Project main + accent colors"
          },
          {
            "value": "custom",
            "label": "Custom footer colors"
          }
        ]
      },
      {
        "id": "footerColor1",
        "label": "Custom footer top-line color",
        "type": "color",
        "visibleWhen": {
          "field": "wordmarkColorMode",
          "equals": "custom"
        }
      },
      {
        "id": "footerColor2",
        "label": "Custom footer bottom-line color",
        "type": "color",
        "visibleWhen": {
          "field": "wordmarkColorMode",
          "equals": "custom"
        }
      },
      {
        "id": "wordmarkFontMode",
        "label": "Footer wordmark font",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Project Identity font"
          },
          {
            "value": "custom",
            "label": "Custom footer font"
          }
        ]
      },
      {
        "id": "footerFontFamily",
        "label": "Custom footer font",
        "type": "select",
        "options": [
          {
            "value": "League Spartan",
            "label": "League Spartan"
          },
          {
            "value": "Arial Black",
            "label": "Arial Black"
          },
          {
            "value": "Impact",
            "label": "Impact"
          },
          {
            "value": "system-ui",
            "label": "System UI"
          },
          {
            "value": "Georgia",
            "label": "Georgia"
          }
        ],
        "visibleWhen": {
          "field": "wordmarkFontMode",
          "equals": "custom"
        }
      },
      {
        "id": "footerFontWeight",
        "label": "Custom footer font weight",
        "type": "range",
        "min": 100,
        "max": 950,
        "step": 50,
        "visibleWhen": {
          "field": "wordmarkFontMode",
          "equals": "custom"
        }
      },
      {
        "id": "projectLogoSize",
        "label": "Project logo size",
        "type": "range",
        "min": 32,
        "max": 140,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "projectTextSize",
        "label": "Project wordmark size",
        "type": "range",
        "min": 10,
        "max": 44,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "brandRowWidthMode",
        "label": "Branding row width",
        "type": "select",
        "options": [
          {
            "value": "full",
            "label": "Full Width"
          },
          {
            "value": "fit-content",
            "label": "Fit Content"
          }
        ]
      },
      {
        "id": "brandFitExtraWidth",
        "label": "Fit-content extra width",
        "type": "range",
        "min": 0,
        "max": 200,
        "step": 1,
        "unit": "px total",
        "visibleWhen": {
          "field": "brandRowWidthMode",
          "equals": "fit-content"
        },
        "help": "Total extra horizontal room around project branding. LOOM divides this evenly between left and right."
      },
      {
        "id": "brandFitExtraHeight",
        "label": "Fit-content extra height",
        "type": "range",
        "min": 0,
        "max": 200,
        "step": 1,
        "unit": "px total",
        "visibleWhen": {
          "field": "brandRowWidthMode",
          "equals": "fit-content"
        },
        "help": "Total extra vertical room around project branding. LOOM divides this evenly between top and bottom."
      },
      {
        "id": "brandRowAlign",
        "label": "Branding row position",
        "type": "select",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "id": "brandRowPaddingX",
        "label": "Branding row horizontal padding",
        "type": "range",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "visibleWhen": {
          "field": "brandRowWidthMode",
          "equals": "full"
        }
      },
      {
        "id": "brandRowPaddingY",
        "label": "Branding row vertical padding",
        "type": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "visibleWhen": {
          "field": "brandRowWidthMode",
          "equals": "full"
        }
      },
      {
        "id": "brandRowRadius",
        "label": "Branding row corner radius",
        "type": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "brandRowBackground",
        "label": "Branding row background",
        "type": "color"
      },
      {
        "id": "toolsRowWidthMode",
        "label": "More Tools row width",
        "type": "select",
        "options": [
          {
            "value": "fit-content",
            "label": "Fit Orbs / Content"
          },
          {
            "value": "full",
            "label": "Full Width"
          }
        ]
      },
      {
        "id": "toolsRowAlign",
        "label": "More Tools row position",
        "type": "select",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "id": "toolsRowPaddingX",
        "label": "More Tools horizontal padding",
        "type": "range",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "toolsRowPaddingY",
        "label": "More Tools vertical padding",
        "type": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "toolsRowRadius",
        "label": "More Tools corner radius",
        "type": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "toolsRowBackground",
        "label": "More Tools background",
        "type": "color"
      },
      {
        "id": "loomLogoSize",
        "label": "Animated LOOM mark container size",
        "type": "range",
        "min": 32,
        "max": 110,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "loomTextSize",
        "label": "LOOM attribution text size",
        "type": "range",
        "min": 10,
        "max": 30,
        "step": 1,
        "unit": "px"
      },
      {
        "id": "loomRowWidthMode",
        "label": "LOOM attribution row width",
        "type": "select",
        "options": [
          {
            "value": "fit-content",
            "label": "Fit Content (Default)"
          },
          {
            "value": "full",
            "label": "Full Width"
          }
        ]
      },
      {
        "id": "loomRowAlign",
        "label": "LOOM attribution row position",
        "type": "select",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
