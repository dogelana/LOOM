{
  "schema_version": "1.8",
  "enabled": true,
  "action": {
    "id": "loom.showcase",
    "name": "Showcase",
    "description": "LOOM project showcase with live identity copy, direct project-color inheritance, and a procedural circular badge when no image is uploaded.",
    "kind": "system",
    "behavior": "stateful",
    "autostart": true,
    "parent": "core.load",
    "category": "loom/core/content",
    "tags": [
      "loom",
      "core",
      "project",
      "showcase",
      "summary",
      "bio",
      "image"
    ]
  },
  "module": {
    "entry": "action.js",
    "version": "1.3.0",
    "scope": "project",
    "dependencies": [],
    "styles": [
      "action.css"
    ],
    "order": "00020",
    "order_locked": true
  },
  "config": {
    "bioMode": "project",
    "bioOverride": "",
    "hasImage": false,
    "imageAsset": "assets/showcase.png",
    "imageVersion": "",
    "imageFit": "contain",
    "imageBackgroundMode": "transparent",
    "imageBackgroundColor": "#FFFFFF",
    "imagePadding": 0,
    "projectPrimary": "#111111",
    "projectAccent": "#168346",
    "projectThemeProvided": false,
    "header2": "",
    "bio2": "",
    "header1ColorMode": "primary",
    "header2ColorMode": "accent",
    "header1CustomColor": "#111111",
    "header2CustomColor": "#168346",
    "bio1Color": "#000000",
    "bio2Color": "#000000",
    "projectFontFamily": "Inter, ui-sans-serif, system-ui",
    "projectFontWeight": 800,
    "projectFontCss": ""
  },
  "presentation": {
    "role": "content",
    "collapsible": true,
    "mount": {
      "region": "root"
    },
    "layout": {
      "width": "full",
      "align": "stretch",
      "position": "flow",
      "order": 20
    },
    "orb": {
      "label": "Showcase",
      "defaultCaptured": false,
      "defaultEmoji": "🖼️"
    }
  },
  "pegboard": {
    "preferredDepth": 1,
    "accent": "green"
  },
  "user_actions": [],
  "admin_settings": {
    "title": "Showcase",
    "description": "Project-facing showcase. Project name and primary bio stay live; optional second headline/bio and direct project branding colors remain editable. With no uploaded image, LOOM renders a procedural badge from the project primary/accent colors.",
    "fields": [
      {
        "id": "header2",
        "label": "Second headline",
        "type": "text",
        "maxLength": 160,
        "help": "Optional. Blank means no second headline."
      },
      {
        "id": "bio2",
        "label": "Second bio / paragraph",
        "type": "textarea",
        "maxLength": 1800,
        "help": "Optional second paragraph. Blank means it is not rendered."
      },
      {
        "id": "header1ColorMode",
        "label": "Primary headline color",
        "type": "select",
        "options": [
          {
            "value": "primary",
            "label": "Project primary (Default)"
          },
          {
            "value": "accent",
            "label": "Project accent"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ]
      },
      {
        "id": "header1CustomColor",
        "label": "Primary headline custom color",
        "type": "color",
        "visibleWhen": {
          "field": "header1ColorMode",
          "equals": "custom"
        }
      },
      {
        "id": "header2ColorMode",
        "label": "Second headline color",
        "type": "select",
        "options": [
          {
            "value": "accent",
            "label": "Project accent (Default)"
          },
          {
            "value": "primary",
            "label": "Project primary"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ]
      },
      {
        "id": "header2CustomColor",
        "label": "Second headline custom color",
        "type": "color",
        "visibleWhen": {
          "field": "header2ColorMode",
          "equals": "custom"
        }
      },
      {
        "id": "bio1Color",
        "label": "Primary bio color",
        "type": "color",
        "help": "Black by default for maximum readability."
      },
      {
        "id": "bio2Color",
        "label": "Second bio color",
        "type": "color",
        "help": "Black by default."
      },
      {
        "id": "imageFit",
        "label": "Uploaded image fit",
        "type": "select",
        "options": [
          {
            "value": "contain",
            "label": "Contain · Show Full Image"
          },
          {
            "value": "cover",
            "label": "Cover · Fill / Crop"
          }
        ]
      },
      {
        "id": "imageBackgroundMode",
        "label": "Uploaded image background",
        "type": "select",
        "options": [
          {
            "value": "transparent",
            "label": "Transparent / Alpha (Default)"
          },
          {
            "value": "project-accent-soft",
            "label": "Project Accent · Soft"
          },
          {
            "value": "project-primary-soft",
            "label": "Project Primary · Soft"
          },
          {
            "value": "page",
            "label": "Project Page Background"
          },
          {
            "value": "loom-soft",
            "label": "LOOM Soft Default"
          },
          {
            "value": "white",
            "label": "White"
          },
          {
            "value": "custom",
            "label": "Custom Color"
          }
        ]
      },
      {
        "id": "imageBackgroundColor",
        "label": "Custom uploaded-image background",
        "type": "color",
        "visibleWhen": {
          "field": "imageBackgroundMode",
          "equals": "custom"
        }
      },
      {
        "id": "imagePadding",
        "label": "Uploaded image breathing room",
        "type": "range",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px"
      }
    ],
    "tools": [
      {
        "type": "showcase-manager",
        "label": "Showcase Content"
      }
    ]
  },
  "capabilities": {
    "provides": [
      {
        "id": "loom.showcase",
        "description": "Project showcase presentation using persistent project-owned media and profile-aware copy"
      }
    ],
    "requires": [],
    "permissions": []
  }
}
