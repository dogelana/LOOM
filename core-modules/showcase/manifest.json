{
  "schema_version": "1.8",
  "enabled": true,
  "action": {
    "id": "loom.showcase",
    "name": "Showcase",
    "description": "LOOM project showcase card with persistent transparent-friendly media, project-bio-aware summary, project-theme integration, and native collapse-frame integration.",
    "kind": "system",
    "behavior": "stateful",
    "autostart": true,
    "parent": "core.load",
    "category": "loom/core/content",
    "tags": [
      "loom",
      "core",
      "project",
      "showcase",
      "summary",
      "bio",
      "image"
    ]
  },
  "module": {
    "entry": "action.js",
    "version": "1.1.1",
    "scope": "project",
    "dependencies": [],
    "styles": [
      "action.css"
    ],
    "order": "00020",
    "order_locked": true
  },
  "config": {
    "bioMode": "project",
    "bioOverride": "",
    "hasImage": false,
    "imageAsset": "assets/showcase.png",
    "imageVersion": "",
    "imageFit": "contain",
    "imageBackgroundMode": "transparent",
    "imageBackgroundColor": "#FFFFFF",
    "imagePadding": 0,
    "projectPrimary": "#111111",
    "projectAccent": "#168346",
    "projectThemeProvided": false
  },
  "presentation": {
    "role": "content",
    "collapsible": true,
    "mount": {
      "region": "root"
    },
    "layout": {
      "width": "full",
      "align": "stretch",
      "position": "flow",
      "order": 20
    },
    "orb": {
      "label": "Showcase",
      "defaultCaptured": false,
      "defaultEmoji": "🖼️"
    }
  },
  "pegboard": {
    "preferredDepth": 1,
    "accent": "green"
  },
  "user_actions": [],
  "admin_settings": {
    "title": "Showcase",
    "description": "Project-facing image + summary. Uploaded PNG transparency is preserved. Media centers without cropping by default, and its backdrop can be transparent, project-derived, LOOM-derived, or custom.",
    "fields": [
      {
        "id": "imageFit",
        "label": "Image fit",
        "type": "select",
        "options": [
          {
            "value": "contain",
            "label": "Contain · Show Full Image"
          },
          {
            "value": "cover",
            "label": "Cover · Fill / Crop"
          }
        ]
      },
      {
        "id": "imageBackgroundMode",
        "label": "Image background",
        "type": "select",
        "options": [
          {
            "value": "transparent",
            "label": "Transparent / Alpha (Default)"
          },
          {
            "value": "project-accent-soft",
            "label": "Project Accent · Soft"
          },
          {
            "value": "project-primary-soft",
            "label": "Project Primary · Soft"
          },
          {
            "value": "page",
            "label": "Project Page Background"
          },
          {
            "value": "loom-soft",
            "label": "LOOM Soft Default"
          },
          {
            "value": "white",
            "label": "White"
          },
          {
            "value": "custom",
            "label": "Custom Color"
          }
        ]
      },
      {
        "id": "imageBackgroundColor",
        "label": "Custom image background",
        "type": "color",
        "visibleWhen": {
          "field": "imageBackgroundMode",
          "equals": "custom"
        }
      },
      {
        "id": "imagePadding",
        "label": "Image breathing room",
        "type": "range",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px"
      }
    ],
    "tools": [
      {
        "type": "showcase-manager",
        "label": "Showcase Content"
      }
    ]
  },
  "capabilities": {
    "provides": [
      {
        "id": "loom.showcase",
        "description": "Project showcase presentation using persistent project-owned media and profile-aware copy"
      }
    ],
    "requires": [],
    "permissions": []
  }
}
