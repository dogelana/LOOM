{
  "schema_version": "1.8",
  "enabled": true,
  "action": {
    "id": "loom.social-links",
    "name": "Social Links",
    "description": "Injects optional project social and web links into the project footer between project branding and More Tools.",
    "kind": "system",
    "behavior": "stateful",
    "autostart": true,
    "parent": "core.ui.footer-bar",
    "category": "loom/project/footer",
    "tags": [
      "loom",
      "core",
      "project",
      "footer",
      "social",
      "links",
      "branding"
    ]
  },
  "module": {
    "entry": "action.js",
    "version": "1.1.0",
    "scope": "project",
    "order": "00007",
    "dependencies": [
      "core.ui.footer-bar"
    ],
    "styles": [
      "action.css"
    ]
  },
  "presentation": {
    "role": "content",
    "collapsible": false,
    "mount": {
      "region": "footer-bar"
    },
    "layout": {
      "width": "auto",
      "align": "center",
      "position": "flow",
      "order": 0,
      "className": "loom-social-links-module"
    }
  },
  "config": {
    "facebookUrl": "",
    "instagramUrl": "",
    "youtubeUrl": "",
    "tiktokUrl": "",
    "websiteUrl": "",
    "customUrl": "",
    "customLabel": "Custom link",
    "customIcon": "link",
    "colorMode": "project",
    "manualColor": "#000000",
    "iconSize": 24,
    "projectColor": "#000000"
  },
  "pegboard": {
    "preferredDepth": 2,
    "accent": "green"
  },
  "user_actions": [],
  "admin_settings": {
    "title": "Social Links",
    "description": "Simple project social handles. Enter a username/handle (preferred) or paste a full profile URL; LOOM canonicalizes locally without contacting the social network.",
    "fields": [
      {
        "id": "websiteUrl",
        "label": "Website URL",
        "type": "text",
        "help": "Full website URL. If https:// is omitted, LOOM adds it locally. No network validation is performed during project startup.",
        "maxLength": 500
      },
      {
        "id": "youtubeUrl",
        "label": "YouTube username or URL",
        "type": "text",
        "help": "Example: @YourChannel or YourChannel. LOOM builds https://www.youtube.com/@YourChannel. Full YouTube URLs also work.",
        "socialPlatform": "youtube",
        "maxLength": 240
      },
      {
        "id": "facebookUrl",
        "label": "Facebook username or URL",
        "type": "text",
        "help": "Example: YourPage. LOOM builds https://www.facebook.com/YourPage. Full Facebook URLs also work.",
        "socialPlatform": "facebook",
        "maxLength": 240
      },
      {
        "id": "tiktokUrl",
        "label": "TikTok username or URL",
        "type": "text",
        "help": "Example: @yourname or yourname. LOOM builds https://www.tiktok.com/@yourname. Full TikTok URLs also work.",
        "socialPlatform": "tiktok",
        "maxLength": 240
      },
      {
        "id": "instagramUrl",
        "label": "Instagram username or URL",
        "type": "text",
        "help": "Example: yourname. LOOM builds https://www.instagram.com/yourname/. Full Instagram URLs also work.",
        "socialPlatform": "instagram",
        "maxLength": 240
      },
      {
        "id": "customUrl",
        "label": "Custom link URL",
        "type": "text",
        "help": "Optional full URL. LOOM validates only the URL shape locally; project startup never resolves or retries the destination.",
        "maxLength": 500
      },
      {
        "id": "customLabel",
        "label": "Custom link label",
        "type": "text",
        "help": "Used for hover/accessibility text."
      },
      {
        "id": "customIcon",
        "label": "Custom link icon",
        "type": "select",
        "options": [
          {
            "value": "link",
            "label": "Link"
          },
          {
            "value": "envelope",
            "label": "Email / Message"
          },
          {
            "value": "store",
            "label": "Store"
          },
          {
            "value": "calendar",
            "label": "Calendar"
          },
          {
            "value": "location",
            "label": "Location"
          },
          {
            "value": "phone",
            "label": "Phone"
          },
          {
            "value": "heart",
            "label": "Heart"
          },
          {
            "value": "star",
            "label": "Star"
          },
          {
            "value": "community",
            "label": "Community"
          },
          {
            "value": "book",
            "label": "Book"
          },
          {
            "value": "music",
            "label": "Music"
          },
          {
            "value": "camera",
            "label": "Camera"
          },
          {
            "value": "game",
            "label": "Game"
          },
          {
            "value": "news",
            "label": "News"
          },
          {
            "value": "rss",
            "label": "RSS"
          },
          {
            "value": "shopping",
            "label": "Shopping"
          },
          {
            "value": "food",
            "label": "Food"
          },
          {
            "value": "paw",
            "label": "Paw / Pet"
          },
          {
            "value": "leaf",
            "label": "Leaf / Nature"
          },
          {
            "value": "github",
            "label": "GitHub"
          },
          {
            "value": "discord",
            "label": "Discord"
          },
          {
            "value": "linkedin",
            "label": "LinkedIn"
          },
          {
            "value": "x",
            "label": "X / Twitter"
          },
          {
            "value": "pinterest",
            "label": "Pinterest"
          },
          {
            "value": "spotify",
            "label": "Spotify"
          },
          {
            "value": "twitch",
            "label": "Twitch"
          }
        ]
      },
      {
        "id": "colorMode",
        "label": "Icon color source",
        "type": "select",
        "options": [
          {
            "value": "project",
            "label": "Project default"
          },
          {
            "value": "loom",
            "label": "LOOM default · black"
          },
          {
            "value": "manual",
            "label": "Custom color"
          }
        ],
        "help": "Project default is set in Project Identity. LOOM default is solid black."
      },
      {
        "id": "manualColor",
        "label": "Custom icon color",
        "type": "color",
        "visibleWhen": {
          "field": "colorMode",
          "equals": "manual"
        }
      },
      {
        "id": "iconSize",
        "label": "Icon size",
        "type": "range",
        "min": 18,
        "max": 42,
        "step": 1,
        "unit": "px"
      }
    ]
  }
}
